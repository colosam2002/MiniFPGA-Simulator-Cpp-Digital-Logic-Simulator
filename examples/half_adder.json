{
  "signals": [
    { "name": "A", "initial": true },
    { "name": "B", "initial": false },

    { "name": "SUM", "initial": false },
    { "name": "CARRY", "initial": false }
  ],

  "components": [
    {
      "type": "XOR",
      "name": "XOR_SUM",
